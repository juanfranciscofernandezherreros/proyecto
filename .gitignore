# Los subproyectos se incluyen como submodulos de git (ver .gitmodules): cada uno
# mantiene su propio repositorio e historial, y proyecto los referencia.
/.tmp-ai-generic-generation-content/

# Material archivado y datos generados.
/_archivo/
/outputs/
/logs/
*.log

# Dependencias, compilados y caches.
/.m2/
**/target/
**/node_modules/
**/.venv/
__pycache__/
*.pyc

# Configuracion local de herramientas (puede llevar credenciales).
/.codex/
/.vscode/
/.claude/

# Configuracion propia de esta maquina (rutas, contrasenas reales).
/config/basketball.local.env

# Herramientas descargadas (drivers de navegador).
/.tools/
