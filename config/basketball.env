# Configuracion unica del proyecto Basketball. La leen los .bat (scripts\config.bat),
# los .ps1 (scripts\config.ps1) y los .py (python\proyecto_config.py).
#
# Prioridad: variable de entorno > config\basketball.local.env > este fichero.
# Para cambiar algo solo en esta maquina (o poner contrasenas reales) crea
# config\basketball.local.env con las claves que quieras; esta fuera de git.
#
# Formato: CLAVE=valor. ${CLAVE} usa otra clave ya definida.
# ${WORKSPACE} es la carpeta del proyecto y se calcula sola.

# --- Datos ---------------------------------------------------------------
DATA_DIR=C:\data\basketball
COMPETITIONS_DIR=${DATA_DIR}\competitions
REPORTS_DIR=${DATA_DIR}\reports
REPORT_DIR=${REPORTS_DIR}\orchestrator
READY_ROOT=C:\data\basketball-ready
READY_DIR=${READY_ROOT}\current
# Raiz desde la que el launcher acepta CSV (debe contener COMPETITIONS_DIR y READY_DIR).
LAUNCHER_CSV_ALLOWED_ROOT=C:\data

# --- Herramientas ----------------------------------------------------------
# Vacio: se usa la variable de entorno JAVA_HOME o, si no existe, el JDK 21 mas reciente instalado.
JAVA_HOME=
# Catalogo de ligas (lo lee tambien el modulo Java de auditoria de pendientes).
LEAGUE_CATALOG=${WORKSPACE}\LIGAS_BASKET.json
SCRAPER_DIR=${WORKSPACE}\python-pyppeter
PYTHON=${SCRAPER_DIR}\.venv\Scripts\python.exe
SCRAPER=${SCRAPER_DIR}\flashscore.py
BATCH_ROOT=${WORKSPACE}\csv-extra-batch
# Navegador del scraper: edge o chrome. Edge porque su driver esta firmado por Microsoft
# y Smart App Control lo permite (bloquea el chromedriver sin firma). El driver lo mantiene
# al dia scripts\arranque\ACTUALIZAR_EDGEDRIVER.ps1 (servicio "navegador" de ASEGURAR).
FLASHSCORE_BROWSER=edge
EDGEDRIVER_PATH=${WORKSPACE}\.tools\msedgedriver\msedgedriver.exe
DOCKER_DESKTOP=C:\Program Files\Docker\Docker\Docker Desktop.exe
COMPOSE_FILE=${WORKSPACE}\local-validation\docker-compose.yml
POSTGRES_CONTAINER=local-validation-postgres-1

# --- Ligas que procesan el arranque, el ciclo diario, ORQUESTAR y PENDIENTES ---------
# Vacio = todas. Varios valores separados por comas, como en LIGAS_BASKET.json:
#   FILTRO_PAIS=spain,europe      FILTRO_COMPETICION=liga-endesa,euroleague
FILTRO_PAIS=
FILTRO_COMPETICION=

# --- Servicios ---------------------------------------------------------------
LAUNCHER_URL=http://localhost:8088
AUDIT_URL=http://localhost:8090/fixtures-processing-audit
API_URL=http://localhost:8082
GRAFANA_URL=http://localhost:8084

# --- Base de datos -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=55432
DB_NAME=basketball
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# --- Credenciales del entorno local de pruebas ------------------------------------
# Para otras credenciales, ponlas en config\basketball.local.env, nunca aqui.
DB_USER=test
DB_PASS=test
GRAFANA_USER=admin
GRAFANA_PASSWORD=local-dashboard-admin
